NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://intake:intake@localhost:5432/intake
TEST_DATABASE_URL=postgresql://intake:intake@localhost:5432/intake_test
SESSION_SECRET=local-development-secret-change-me

S3_BUCKET=image-intake
S3_REGION=us-east-1
# where the API and worker read and write objects
S3_ENDPOINT=http://localhost:9000
# the host the browser can reach; only used for signing URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=localaccess
S3_SECRET_ACCESS_KEY=localsecret
S3_FORCE_PATH_STYLE=true

WORKER_CONCURRENCY=2
S3_CREATE_BUCKET=true
